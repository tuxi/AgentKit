    "conversation.archived_desc": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History and Worktree have been preserved. Restore to continue execution."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史记录和 Worktree 均已保留；恢复后可以继续执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歷史記錄和 Worktree 均已保留；恢復後可以繼續執行。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴とワークツリーは保持されています。復元して実行を続行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록과 Worktree가 보존되었습니다. 복원하여 계속 실행할 수 있습니다."
          }
