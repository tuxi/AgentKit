          "stringUnit": {
            "state": "translated",
            "value": "Interrupted %@ hours ago. Tap Continue to resume."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "中断于 %@ 小时前，点击继续恢复执行。"
