            "value": "Supports GitHub, GitLab, Gitee, and public self-hosted Git services. Login credentials are not transmitted."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 GitHub、GitLab、Gitee 和公开自建 Git 服务；不传输登录凭据。"
          }
