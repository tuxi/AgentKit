{
  "default_model": "gateway",
  "credentials": {
    "gateway": {
      "default": {
        "source": "injected"
      }
    },
    "llm": {
      "deepseek": {
        "source": "env",
        "env": "DEEPSEEK_API_KEY"
      },
      "qwen": {
        "source": "env",
        "env": "DASHSCOPE_API_KEY"
      },
      "glm": {
        "source": "env",
        "env": "GLM_API_KEY"
      }
    }
  },
  "models": {
    "gateway": {
      "provider": "openai",
      "base_url": "__GATEWAY_BASE_URL__",
      "model": "",
      "credential": {
        "namespace": "gateway",
        "name": "default"
      },
      "context_window": 128000
    },
    "deepseek": {
      "provider": "openai",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-v4-flash",
      "credential": {
        "namespace": "llm",
        "name": "deepseek"
      },
      "temperature": 0.2,
      "context_window": 128000,
      "input_price_per_million": 0.27,
      "output_price_per_million": 1.10,
      "cache_input_price_per_million": 0.027
    },
    "deepseek-pro": {
      "provider": "openai",
      "base_url": "https://api.deepseek.com",
      "model": "deepseek-v4-pro",
      "credential": {
        "namespace": "llm",
        "name": "deepseek"
      },
      "context_window": 128000
    }
  },
  "agent": {
    "max_steps": 100,
    "max_parallel_tools": 6,
    "compact_ratio": 0.75,
    "client_tool_timeout_seconds": 900
  },
  "provider": {
    "request_timeout_seconds": 600,
    "max_retries": 5,
    "backoff_millis": 500,
    "max_backoff_seconds": 8
  },
  "web": {
    "search": {
      "provider": "gateway",
      "gateway_base_url": "__GATEWAY_BASE_URL__",
      "top_k": 5,
      "timeout_seconds": 600
    },
    "fetch": {
      "timeout_seconds": 30,
      "cache_ttl_seconds": 600
    }
  },
  "runtime": {
    "max_concurrent_turns": 10
  },
  "currency": "$"
}
